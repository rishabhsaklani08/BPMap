{
  "name": "bpmap",
  "private": true,
  "type": "module",
  "description": "BPMap for Workday: see, simulate and govern Workday business processes, privately in the browser.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @bpmap/web",
    "build": "npm run build -w @bpmap/web",
    "preview": "npm run preview -w @bpmap/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixtures": "node packages/fixtures/scripts/make-fixtures.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "playwright test",
    "oracle": "python3 -I tools/oracle/workday_export_oracle.py",
    "guide:capture": "node docs/guide-build/capture.mjs",
    "guide": "python3 -I docs/guide-build/build_guide.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.0.0",
    "exceljs": "^4.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
